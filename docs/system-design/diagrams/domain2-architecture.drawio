<mxfile host="app.diagrams.net">
  <diagram id="domain2-architecture" name="Domain 2 Architecture">
    <mxGraphModel dx="1118" dy="1934" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" value="Domain 2 Discovery &amp; Matching Architecture" vertex="1">
          <mxGeometry height="30" width="520" x="110" y="-240" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" value="Based on current code in infra/stacks/domain2_stack.py" vertex="1">
          <mxGeometry height="20" width="420" x="110" y="-210" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" value="Clients&#xa;- Web app (Next.js)&#xa;- Authenticated users (JWT)" vertex="1">
          <mxGeometry height="90" width="180" x="140" y="290" as="geometry" />
        </mxCell>
        <mxCell id="domain" parent="1" style="swimlane;html=1;rounded=1;whiteSpace=wrap;horizontal=1;startSize=32;fillColor=#f9fafb;strokeColor=#111827;fontSize=16;fontStyle=1;" value="Domain 2 Stack (KismetDomain2)" vertex="1">
          <mxGeometry height="1080" width="1280" x="370" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="restApi" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=13;" value="Imported Shared REST API&#xa;+ Cognito Authorizer" vertex="1">
          <mxGeometry height="70" width="220" x="10" y="470" as="geometry" />
        </mxCell>
        <mxCell id="discoveryService" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" value="Discovery Service&#xa;GET /discovery&#xa;- filter by age, gender&#xa;- exclude already-swiped&#xa;- attach BaZi score&#xa;- cursor pagination" vertex="1">
          <mxGeometry height="130" width="260" x="330" y="50" as="geometry" />
        </mxCell>
        <mxCell id="swipeService" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" value="Swipe Service&#xa;POST /swipe&#xa;GET /swipe/history&#xa;- records like / pass&#xa;- publishes swipe.created (like only)" vertex="1">
          <mxGeometry height="120" width="260" x="330" y="230" as="geometry" />
        </mxCell>
        <mxCell id="matchService" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" value="Match Service&#xa;GET /matches&#xa;GET /matches/{matchId}&#xa;DELETE /matches/{matchId}&#xa;- detects mutual likes&#xa;- atomic match creation (TransactWrite)&#xa;- publishes match.created&#xa;- purges on user.deleted / profile.banned" vertex="1">
          <mxGeometry height="160" width="260" x="330" y="400" as="geometry" />
        </mxCell>
        <mxCell id="recoService" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" value="Recommendation Service&#xa;GET /recommend&#xa;POST /recommend/refresh&#xa;- composite scoring:&#xa;  BaZi (0-40) + profile (0-20)&#xa;  + recency (10)&#xa;- cached per user" vertex="1">
          <mxGeometry height="140" width="260" x="330" y="590" as="geometry" />
        </mxCell>
        <mxCell id="baziService" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" value="BaZi Service&#xa;POST /bazi/top-matches&#xa;- stateless proxy&#xa;- calls external API" vertex="1">
          <mxGeometry height="100" width="260" x="330" y="790" as="geometry" />
        </mxCell>
        <mxCell id="baziApi" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;" value="External BaZi API&#xa;match-date-nu.vercel.app&#xa;八字 compatibility scoring" vertex="1">
          <mxGeometry height="80" width="260" x="730" y="800" as="geometry" />
        </mxCell>
        <mxCell id="discoveryTable" parent="domain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" value="DynamoDB&#xa;kismet-discovery&#xa;PK=PROFILE#{userId} SK=META&#xa;PK=BAZI#{birthDate} SK=SCORES&#xa;(candidate index + BaZi cache)" vertex="1">
          <mxGeometry height="130" width="250" x="720" y="50" as="geometry" />
        </mxCell>
        <mxCell id="swipesTable" parent="domain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" value="DynamoDB&#xa;kismet-swipes&#xa;PK=userId SK=targetUserId&#xa;action: like | pass" vertex="1">
          <mxGeometry height="100" width="250" x="720" y="250" as="geometry" />
        </mxCell>
        <mxCell id="matchesTable" parent="domain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" value="DynamoDB&#xa;kismet-matches&#xa;PAIR#{A}#{B} | META (dedup)&#xa;MATCH#{matchId} | META&#xa;USER#{userId} | MATCH#{ts}#{id}&#xa;(transact_write_items)" vertex="1">
          <mxGeometry height="140" width="250" x="720" y="400" as="geometry" />
        </mxCell>
        <mxCell id="recoTable" parent="domain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" value="DynamoDB&#xa;kismet-recommendations&#xa;PK=USER#{userId}&#xa;SK=SCORE#{score}#{candidateId}&#xa;(sorted by score desc)" vertex="1">
          <mxGeometry height="120" width="250" x="720" y="600" as="geometry" />
        </mxCell>
        <mxCell id="eventBus" parent="domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;fontStyle=1;" value="EventBridge&#xa;kismet-events" vertex="1">
          <mxGeometry height="60" width="180" x="1080" y="220" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="domain" source="restApi" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" target="discoveryService" value="GET /discovery">
