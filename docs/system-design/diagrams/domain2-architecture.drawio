<mxfile host="65bd71144e">
    <diagram id="domain2-architecture" name="Domain 2 Architecture">
        <mxGraphModel dx="2115" dy="1237" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Domain 2 Discovery &amp; Matching Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="520" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Based on current code in infra/stacks/domain2_stack.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" parent="1" vertex="1">
                    <mxGeometry x="30" y="50" width="420" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="client" value="Clients&#xa;- Web app (Next.js)&#xa;- Authenticated users (JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="50" y="350" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="domain" value="Domain 2 Stack (KismetDomain2)" style="swimlane;html=1;rounded=1;whiteSpace=wrap;horizontal=1;startSize=32;fillColor=#f9fafb;strokeColor=#111827;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="280" y="80" width="1280" height="1080" as="geometry"/>
                </mxCell>
                <!-- REST API entry -->
                <mxCell id="restApi" value="Imported Shared REST API&#xa;+ Cognito Authorizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="30" y="160" width="220" height="70" as="geometry"/>
                </mxCell>
                <!-- Discovery Service -->
                <mxCell id="discoveryService" value="Discovery Service&#xa;GET /discovery&#xa;- filter by age, gender&#xa;- exclude already-swiped&#xa;- attach BaZi score&#xa;- cursor pagination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="50" width="260" height="130" as="geometry"/>
                </mxCell>
                <!-- Swipe Service -->
                <mxCell id="swipeService" value="Swipe Service&#xa;POST /swipe&#xa;GET /swipe/history&#xa;- records like / pass&#xa;- publishes swipe.created (like only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="230" width="260" height="120" as="geometry"/>
                </mxCell>
                <!-- Match Service -->
                <mxCell id="matchService" value="Match Service&#xa;GET /matches&#xa;GET /matches/{matchId}&#xa;DELETE /matches/{matchId}&#xa;- detects mutual likes&#xa;- atomic match creation&#xa;- publishes match.created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="400" width="260" height="140" as="geometry"/>
                </mxCell>
                <!-- Recommendation Service -->
                <mxCell id="recoService" value="Recommendation Service&#xa;GET /recommend&#xa;POST /recommend/refresh&#xa;- composite scoring:&#xa;  BaZi (0-40) + profile (0-20)&#xa;  + recency (10)&#xa;- cached per user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="590" width="260" height="140" as="geometry"/>
                </mxCell>
                <!-- BaZi Service -->
                <mxCell id="baziService" value="BaZi Service&#xa;POST /bazi/top-matches&#xa;- stateless proxy&#xa;- calls external API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="790" width="260" height="100" as="geometry"/>
                </mxCell>
                <!-- External BaZi API -->
                <mxCell id="baziApi" value="External BaZi API&#xa;match-date-nu.vercel.app&#xa;八字 compatibility scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="330" y="950" width="260" height="80" as="geometry"/>
                </mxCell>
                <!-- DynamoDB: kismet-discovery -->
                <mxCell id="discoveryTable" value="DynamoDB&#xa;kismet-discovery&#xa;PK=PROFILE#{userId} SK=META&#xa;PK=BAZI#{birthDate} SK=SCORES&#xa;(candidate index + BaZi cache)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="720" y="50" width="250" height="130" as="geometry"/>
                </mxCell>
                <!-- DynamoDB: kismet-swipes -->
                <mxCell id="swipesTable" value="DynamoDB&#xa;kismet-swipes&#xa;PK=userId SK=targetUserId&#xa;action: like | pass" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="720" y="250" width="250" height="100" as="geometry"/>
                </mxCell>
                <!-- DynamoDB: kismet-matches -->
                <mxCell id="matchesTable" value="DynamoDB&#xa;kismet-matches&#xa;PAIR#{A}#{B} | META (dedup)&#xa;MATCH#{matchId} | META&#xa;USER#{userId} | MATCH#{ts}#{id}&#xa;(transact_write_items)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="720" y="400" width="250" height="140" as="geometry"/>
                </mxCell>
                <!-- DynamoDB: kismet-recommendations -->
                <mxCell id="recoTable" value="DynamoDB&#xa;kismet-recommendations&#xa;PK=USER#{userId}&#xa;SK=SCORE#{score}#{candidateId}&#xa;(sorted by score desc)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fde68a;strokeColor=#ca8a04;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="720" y="600" width="250" height="120" as="geometry"/>
                </mxCell>
                <!-- EventBridge -->
                <mxCell id="eventBus" value="EventBridge&#xa;kismet-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;fontStyle=1;" parent="domain" vertex="1">
                    <mxGeometry x="1050" y="310" width="180" height="60" as="geometry"/>
                </mxCell>
                <!-- External consumers -->
                <mxCell id="consumers" value="External Event Consumers&#xa;- D3 Icebreaker (match.created)&#xa;- D4 Moderation&#xa;- D5 Push Notification (match)&#xa;- D5 Email Service (match)&#xa;- D6 Activity Logger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="1010" y="430" width="240" height="130" as="geometry"/>
                </mxCell>
                <!-- Domain 1 event source -->
                <mxCell id="d1Source" value="Domain 1 (Identity)&#xa;profile.completed event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;" parent="domain" vertex="1">
                    <mxGeometry x="1050" y="160" width="200" height="60" as="geometry"/>
                </mxCell>
                <!-- Edges: REST API → Services -->
                <mxCell id="e1" value="GET /discovery" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" parent="domain" source="restApi" target="discoveryService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="POST /swipe&#xa;GET /swipe/history" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" parent="domain" source="restApi" target="swipeService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="GET/DELETE /matches" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" parent="domain" source="restApi" target="matchService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="GET /recommend&#xa;POST /recommend/refresh" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" parent="domain" source="restApi" target="recoService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="POST /bazi/top-matches" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=11;" parent="domain" source="restApi" target="baziService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Edges: Services → Tables -->
                <mxCell id="e6" value="scan candidates&#xa;+ BaZi cache lookup" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;" parent="domain" source="discoveryService" target="discoveryTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="query swiped users" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;dashed=1;" parent="domain" source="discoveryService" target="swipesTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="put / query" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;" parent="domain" source="swipeService" target="swipesTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" value="check reverse swipe" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;dashed=1;" parent="domain" source="matchService" target="swipesTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" value="transact write / query" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;" parent="domain" source="matchService" target="matchesTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e11" value="read profiles + BaZi" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;dashed=1;" parent="domain" source="recoService" target="discoveryTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e12" value="cache scores" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;" parent="domain" source="recoService" target="recoTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" value="exclude swiped" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;dashed=1;" parent="domain" source="recoService" target="swipesTable" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Edges: Events -->
                <mxCell id="e14" value="swipe.created" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;" parent="domain" source="swipeService" target="eventBus" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e15" value="match.created" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;" parent="domain" source="matchService" target="eventBus" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e16" value="consumed by&#xa;other domains" style="curved=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6b7280;fontSize=11;" parent="domain" source="eventBus" target="consumers" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Incoming events -->
                <mxCell id="e17" value="profile.completed" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;" parent="domain" source="d1Source" target="eventBus" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e18" value="index profile" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;dashed=1;" parent="domain" source="eventBus" target="discoveryService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e19" value="invalidate cache" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;dashed=1;" parent="domain" source="eventBus" target="recoService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e20" value="swipe.created → detect mutual like" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;dashed=1;" parent="domain" source="eventBus" target="matchService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e21" value="swipe.created → remove candidate" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontSize=11;dashed=1;" parent="domain" source="eventBus" target="recoService" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- BaZi external call -->
                <mxCell id="e22" value="POST /api/match&#xa;(X-API-KEY: ABC)" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;fontSize=11;" parent="domain" source="baziService" target="baziApi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" value="BaZi API call&#xa;(cache miss)" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;fontSize=11;dashed=1;" parent="domain" source="discoveryService" target="baziApi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Client → REST API -->
                <mxCell id="e0" value="" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;" parent="1" source="client" target="restApi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
