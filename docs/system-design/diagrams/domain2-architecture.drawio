        <mxCell id="e6" edge="1" parent="domain" source="discoveryService" style="curved=1;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontSize=11;" target="discoveryTable" value="scan candidates&#xa;+ BaZi cache lookup">
          <mxGeometry relative="1" as="geometry" />
