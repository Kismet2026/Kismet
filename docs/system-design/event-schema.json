{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kismet EventBridge Event Schema",
  "description": "所有跨域事件的格式定义。Week 1 锁定，所有 domain 按此格式发布和消费事件。",
  "version": "1.0.0",
  "eventBusName": "kismet-events",

  "events": {
    "swipe.created": {
      "source": "kismet.swipe-service",
      "detail-type": "swipe.created",
      "description": "用户划右（like）时发布。仅 like 触发，pass 不触发。",
      "publisher": "Swipe Service",
      "consumers": ["Match Service", "Recommendation Service", "Activity Logger"],
      "detail": {
        "swipeId": { "type": "string", "example": "swipe-001" },
        "userId": { "type": "string", "example": "user-123", "description": "执行划动的用户" },
        "targetUserId": { "type": "string", "example": "user-456", "description": "被划的用户" },
        "action": { "type": "string", "enum": ["like"], "description": "只有 like 会发事件" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T12:00:00Z" }
      }
    },

    "match.created": {
      "source": "kismet.match-service",
      "detail-type": "match.created",
      "description": "双向 like 检测到匹配时发布。",
      "publisher": "Match Service",
      "consumers": ["Push Notification", "Email Service", "Icebreaker Service", "Activity Logger"],
      "detail": {
        "matchId": { "type": "string", "example": "match-789" },
        "userIds": { "type": "array", "items": { "type": "string" }, "example": ["user-123", "user-456"], "description": "匹配的两个用户 ID" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T12:00:00Z" }
      }
    },

    "message.sent": {
      "source": "kismet.message-service",
      "detail-type": "message.sent",
      "description": "用户发送消息后发布。",
      "publisher": "Message Service",
      "consumers": ["Text Moderation", "Push Notification", "Activity Logger"],
      "detail": {
        "messageId": { "type": "string", "example": "msg-001" },
        "matchId": { "type": "string", "example": "match-789" },
        "senderId": { "type": "string", "example": "user-123" },
        "recipientId": { "type": "string", "example": "user-456", "description": "消息接收方" },
        "content": { "type": "string", "example": "Hey! Nice to meet you" },
        "messageType": { "type": "string", "enum": ["text"], "description": "目前只支持 text" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T12:05:00Z" }
      }
    },

    "photo.uploaded": {
      "source": "kismet.photo-service",
      "detail-type": "photo.uploaded",
      "description": "用户上传照片后发布。触发图片审核。",
      "publisher": "Photo Service",
      "consumers": ["Image Moderation", "Activity Logger"],
      "detail": {
        "photoId": { "type": "string", "example": "photo-001" },
        "userId": { "type": "string", "example": "user-123" },
        "s3Key": { "type": "string", "example": "photos/user-123/photo-001.jpg" },
        "s3Bucket": { "type": "string", "example": "kismet-photos-dev" },
        "contentType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"], "example": "image/jpeg" },
        "cdnUrl": { "type": "string", "example": "https://cdn.kismet.dev/user-123/photo-001.jpg", "description": "CDN URL for the photo (if configured)" },
        "isPrimary": { "type": "boolean", "example": true, "description": "Whether this is the user's primary/avatar photo" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T11:00:00Z" }
      }
    },

    "user.created": {
      "source": "kismet.auth-service",
      "detail-type": "user.created",
      "description": "新用户注册成功后发布。",
      "publisher": "Auth Service",
      "consumers": ["Email Service", "Activity Logger"],
      "detail": {
        "userId": { "type": "string", "example": "user-123" },
        "email": { "type": "string", "example": "student@northeastern.edu" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T10:00:00Z" }
      }
    },

    "profile.completed": {
      "source": "kismet.profile-service",
      "detail-type": "profile.completed",
      "description": "用户首次完成个人资料后发布。Discovery 用于加入发现池并预热 BaZi 缓存。",
      "publisher": "Profile Service",
      "consumers": ["Discovery Service", "Recommendation Service", "Activity Logger"],
      "detail": {
        "userId": { "type": "string", "example": "user-123" },
        "name": { "type": "string", "example": "Alice" },
        "birthDate": { "type": "string", "format": "date", "example": "1999-05-15", "description": "出生日期，用于八字评分" },
        "birthTime": { "type": "string", "example": "14:30", "description": "出生时间（可选）" },
        "gender": { "type": "string", "enum": ["male", "female", "non-binary"] },
        "preferred_gender": { "type": "string", "enum": ["male", "female", "non-binary", "everyone"], "description": "偏好匹配性别（映射自 interestedIn）" },
        "location_coordinates": { "type": "array", "items": { "type": "number" }, "example": [42.36, -71.06], "description": "[lat, lng] 坐标" },
        "city": { "type": "string", "example": "Boston" },
        "avatarUrl": { "type": "string", "example": "https://photos.kismet.dev/user-123/photo.jpg" },
        "bio": { "type": "string", "example": "Astronomy major who loves stargazing" },
        "interests": { "type": "array", "items": { "type": "string" }, "example": ["astronomy", "hiking"] },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T10:30:00Z" }
      }
    },

    "profile.updated": {
      "source": "kismet.profile-service",
      "detail-type": "profile.updated",
      "description": "用户更新个人资料后发布。Discovery 用于同步候选人数据。",
      "publisher": "Profile Service",
      "consumers": ["Discovery Service", "Activity Logger"],
      "detail": {
        "userId": { "type": "string", "example": "user-123" },
        "name": { "type": "string", "example": "Alice" },
        "birthDate": { "type": "string", "format": "date", "example": "1999-05-15" },
        "birthTime": { "type": "string", "example": "14:30" },
        "gender": { "type": "string", "enum": ["male", "female", "non-binary"] },
        "preferred_gender": { "type": "string", "enum": ["male", "female", "non-binary", "everyone"] },
        "location_coordinates": { "type": "array", "items": { "type": "number" }, "example": [42.36, -71.06] },
        "city": { "type": "string", "example": "Boston" },
        "avatarUrl": { "type": "string", "example": "https://photos.kismet.dev/user-123/photo.jpg" },
        "bio": { "type": "string", "example": "Updated bio" },
        "interests": { "type": "array", "items": { "type": "string" }, "example": ["astronomy", "yoga"] },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T13:00:00Z" }
      }
    },

    "user.reported": {
      "source": "kismet.report-service",
      "detail-type": "user.reported",
      "description": "用户提交举报后发布。",
      "publisher": "Report Service",
      "consumers": ["Admin Dashboard", "Email Service", "Activity Logger"],
      "detail": {
        "reportId": { "type": "string", "example": "report-001" },
        "reporterId": { "type": "string", "example": "user-123", "description": "举报人" },
        "reportedUserId": { "type": "string", "example": "user-456", "description": "被举报人" },
        "reason": { "type": "string", "enum": ["harassment", "inappropriate_content", "spam", "fake_profile", "other"] },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T14:00:00Z" }
      }
    },

    "content.flagged": {
      "source": "kismet.moderation",
      "detail-type": "content.flagged",
      "description": "内容审核（文字或图片）检测到违规内容时发布。",
      "publisher": "Text Moderation / Image Moderation",
      "consumers": ["Admin Dashboard", "Activity Logger"],
      "detail": {
        "contentId": { "type": "string", "example": "msg-001 or photo-001" },
        "contentType": { "type": "string", "enum": ["text", "image"] },
        "userId": { "type": "string", "example": "user-123", "description": "内容所有者" },
        "reason": { "type": "string", "example": "toxicity_detected" },
        "score": { "type": "number", "example": 0.92, "description": "审核置信度 0-1" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-01T12:01:00Z" }
      }
    },

    "user.banned": {
      "source": "kismet.report-service",
      "detail-type": "user.banned",
      "description": "Report Service 决定封禁用户时发布（手动 admin resolve=ban 或自动达到阈值）。Profile Service 接收后把 profile.status 置为 banned 并再发 profile.banned。",
      "publisher": "Report Service",
      "consumers": ["Profile Service"],
      "detail": {
        "userId": { "type": "string", "example": "user-456", "description": "被封禁的用户" },
        "reportId": { "type": "string", "example": "report-001", "description": "触发封禁的报告 ID" },
        "reason": { "type": "string", "example": "inappropriate_content" },
        "autoBanned": { "type": "boolean", "example": true, "description": "true 表示达到阈值自动封禁，false 表示 admin 手动封禁" },
        "threshold": { "type": "integer", "example": 2, "description": "仅 autoBanned=true 时存在" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-16T23:14:19Z" }
      }
    },

    "profile.banned": {
      "source": "kismet.profile-service",
      "detail-type": "profile.banned",
      "description": "Profile Service 接收 user.banned 并持久化后发布，供下游服务清理被封禁用户的数据。",
      "publisher": "Profile Service",
      "consumers": ["Discovery Service", "Match Service", "Recommendation Service", "Message Service", "Email Service (planned #120)", "Activity Logger"],
      "detail": {
        "userId": { "type": "string", "example": "user-456" },
        "reason": { "type": "string", "example": "inappropriate_content" },
        "reportId": { "type": "string", "example": "report-001" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-16T23:14:19Z" }
      }
    },

    "user.deleted": {
      "source": "kismet.profile-service",
      "detail-type": "user.deleted",
      "description": "用户调用 DELETE /profiles/me 后发布。触发全域数据清理（照片、匹配、消息、推荐缓存、通知设置等）。",
      "publisher": "Profile Service",
      "consumers": ["Photo Service", "Discovery Service", "Swipe Service", "Match Service", "Recommendation Service", "Message Service", "Email Service", "Activity Logger"],
      "detail": {
        "userId": { "type": "string", "example": "user-123" },
        "timestamp": { "type": "string", "format": "date-time", "example": "2026-04-16T23:14:19Z" }
      }
    }
  },

  "_usage_example": {
    "description": "Python: publish an event to EventBridge",
    "code": [
      "import boto3, json",
      "from datetime import datetime, timezone",
      "",
      "client = boto3.client('events')",
      "",
      "client.put_events(Entries=[{",
      "    'Source': 'kismet.swipe-service',",
      "    'DetailType': 'swipe.created',",
      "    'Detail': json.dumps({",
      "        'swipeId': 'swipe-001',",
      "        'userId': 'user-123',",
      "        'targetUserId': 'user-456',",
      "        'action': 'like',",
      "        'timestamp': datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')",
      "    }),",
      "    'EventBusName': 'kismet-events'",
      "}])"
    ]
  },

  "_consumer_example": {
    "description": "Lambda handler: consume a match.created event",
    "code": [
      "def handler(event, context):",
      "    detail = event['detail']",
      "    match_id = detail['matchId']",
      "    user_ids = detail['userIds']",
      "",
      "    for user_id in user_ids:",
      "        send_push(user_id, 'You have a new match!')",
      "",
      "    return {'statusCode': 200}"
    ]
  }
}
